# Copy to .env to enable sponsors. All optional — the app runs without any of them.

# Gemini (DeepMind) — profiling, reasoning, embeddings.
# Without this the profiler uses a heuristic and embeddings use a hashing fallback.
GEMINI_API_KEY=

# Actian VectorAI DB — the live vector store. Without ACTIAN_HOST (or if the
# server is unreachable) the Matcher pulls neighbours from an in-process numpy
# cosine index instead, and /health reports "actian": "numpy".
#
# Run it locally (this is exactly what the values below connect to):
#   docker run -d --name vectorai \
#     -v ~/.kindred/vectorai-data:/var/lib/actian-vectorai \
#     -p 6573-6575:6573-6575 \
#     -e ACTIAN_VECTORAI_ACCEPT_EULA=YES \
#     actian/vectorai:latest
#   # 6573 = REST, 6574 = gRPC (what the SDK uses), 6575 = local web UI
#   curl localhost:6573/            # -> {"title":"Actian VectorAI DB", ...}
#
# WORKING LOCAL VALUES — host + port is all the container needs; it ships with
# auth disabled, so USER/PASSWORD stay empty.
ACTIAN_HOST=localhost
ACTIAN_PORT=6574
# Collection-name prefix, not a database: creates <DB>_domain + <DB>_trajectory.
# Blank -> "kindred".
ACTIAN_DB=kindred
# Only for deployments with auth enabled; PASSWORD is sent as the SDK api_key.
ACTIAN_USER=
ACTIAN_PASSWORD=
# Seconds before a connect/call gives up and the numpy fallback takes over.
ACTIAN_TIMEOUT=5

# Server
KINDRED_HOST=0.0.0.0
KINDRED_PORT=8000
