# Copy to .env to enable sponsors. All optional — the app runs without any of them.

# Gemini (DeepMind) — profiling, reasoning, embeddings.
# Without this the profiler uses a heuristic and embeddings use a hashing fallback.
GEMINI_API_KEY=

# Actian vector store. Without these the Matcher pulls neighbours from an
# in-process numpy cosine index instead.
ACTIAN_HOST=
ACTIAN_PORT=
ACTIAN_DB=
ACTIAN_USER=
ACTIAN_PASSWORD=

# Server
KINDRED_HOST=0.0.0.0
KINDRED_PORT=8000
